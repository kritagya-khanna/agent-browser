{
  "name": "@kritchoff/agent-browser",
  "version": "1.0.3",
  "description": "Headless browser automation CLI for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "scripts",
    "skills",
    "docker-compose.sdk.yml"
  ],
  "bin": {
    "agent-browser": "./bin/agent-browser.js"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "build:docker": "docker build -t agent-browser-builder -f docker/Dockerfile.build .",
    "release": "npm run build && npm publish",
    "prepublishOnly": "npm run build",
    "start": "node dist/daemon.js",
    "dev": "tsx src/daemon.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "pnpm run build && changeset publish"
  },
  "keywords": [
    "browser",
    "automation",
    "headless",
    "playwright",
    "cli",
    "agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kritagya-khanna/agent-browser.git"
  },
  "bugs": {
    "url": "https://github.com/kritagya-khanna/agent-browser/issues"
  },
  "homepage": "https://github.com/kritagya-khanna/agent-browser#readme",
  "dependencies": {
    "node-simctl": "^7.4.0",
    "playwright-core": "^1.57.0",
    "webdriverio": "^9.15.0",
    "ws": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/**/*.ts": "prettier --write"
  }
}
