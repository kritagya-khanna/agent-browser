# --- Stage 1: Builder ---
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

# Copy package configs
COPY package.json pnpm-lock.yaml ./
COPY cli/Cargo.toml cli/Cargo.lock ./cli/
COPY scripts/ ./scripts/

# Install all dependencies (including devDeps for building)
RUN npm install -g pnpm && pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build TypeScript to dist/
RUN pnpm run build

# --- Stage 2: Runner ---
FROM node:20-bookworm-slim AS runner

# Install runtime requirements (ADB, netcat, socat for bridge)
RUN apt-get update && apt-get install -y \
    adb \
    curl \
    netcat-openbsd \
    socat \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/scripts ./scripts

# Install ONLY production dependencies (skip prepare/husky)
RUN npm install -g pnpm && \
    pnpm install --frozen-lockfile --prod --ignore-scripts && \
    node scripts/postinstall.js

# Copy the startup script
COPY scripts/start-android-agent.sh ./scripts/start-android-agent.sh
RUN chmod +x ./scripts/start-android-agent.sh

# Setup socket dir
RUN mkdir -p /tmp/agent-browser
ENV AGENT_BROWSER_SOCKET_DIR=/tmp/agent-browser
ENV PATH="/app/bin:${PATH}"

# Start
CMD ["./scripts/start-android-agent.sh"]
